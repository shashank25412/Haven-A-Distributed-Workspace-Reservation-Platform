# -----------------------------------------------------------------------------
# Haven Local Environment Configuration
#
# Copy this file to `.env` for local development:
#
#     cp .env.example .env
#
# Do not store secrets or machine-specific credentials in this example file.
# -----------------------------------------------------------------------------

# Address on which the Haven HTTP server listens.
#
# Use 0.0.0.0 inside Docker so the process accepts traffic through the
# container network and published host port.
HVN_HTTP_ADDRESS=0.0.0.0

# TCP port exposed by the Haven HTTP server.
#
# Valid range: 1-65535
HVN_HTTP_PORT=8080

# Required Couchbase connection and namespace configuration.
#
# These values match the local Couchbase conventions documented by Haven.
HVN_COUCHBASE_CONNECTION_STRING=couchbase://127.0.0.1
HVN_COUCHBASE_USERNAME=Administrator
HVN_COUCHBASE_PASSWORD=password
HVN_COUCHBASE_BUCKET=haven
HVN_COUCHBASE_SCOPE=reservation
HVN_IDEMPOTENCY_RETENTION_SECONDS=86400
# Optional Resource detail cache (Couchbase remains authoritative)
HVN_REDIS_ENABLED=false
HVN_REDIS_URI=tcp://127.0.0.1:6379
HVN_REDIS_PASSWORD=
HVN_REDIS_CONNECT_TIMEOUT_MS=100
HVN_REDIS_COMMAND_TIMEOUT_MS=100
HVN_REDIS_RESOURCE_TTL_SECONDS=300

# Optional Kafka event delivery (disabled until publisher orchestration is wired).
HVN_KAFKA_ENABLED=false
HVN_KAFKA_BROKERS=127.0.0.1:9092
HVN_KAFKA_RESERVATION_EVENTS_TOPIC=haven.reservation.events
HVN_KAFKA_CLIENT_ID=haven-reservation-producer
HVN_KAFKA_ACK_TIMEOUT_MS=5000
HVN_KAFKA_DELIVERY_TIMEOUT_MS=10000
